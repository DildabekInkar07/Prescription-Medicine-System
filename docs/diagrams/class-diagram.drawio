  <diagram name="Страница-1" id="zKWgEy1XiNO1Bja30Bi3">
    <mxGraphModel dx="2267" dy="1983" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nclass \&quot;Пайдаланушы\&quot; as User {\n    + user_id: int\n    + логин: string\n    + құпияСөз: string\n    + атыЖөні: string\n    + телефон: string\n    + тіркелгенКүні: date\n    + рөлі: string\n    --\n    + жүйегеКіру(): bool\n    + профильдіЖаңарту(): void\n    + шығу(): void\n}\n\nclass \&quot;Пациент\&quot; as Patient {\n    + ЖСН: string\n    + медициналықКартаНөмірі: string\n    + мекенжайы: string\n    --\n    + рецепттіКөру(): list\n    + брондауЖасау(): void\n    + қабылдауКестесінКөру(): void\n}\n\nclass \&quot;Дәрігер\&quot; as Doctor {\n    + мамандығы: string\n    + кабинетНөмірі: string\n    --\n    + рецептЖазу(): void\n    + рецептӨзгерту(): void\n    + пациентАқпаратКөру(): void\n}\n\nclass \&quot;Фармацевт\&quot; as Pharmacist {\n    + дәріхана_id: int\n    + лауазымы: string\n    --\n    + рецепттіТексеру(): bool\n    + дәрініБеру(): void\n    + броньдыӨңдеу(): void\n    + қорТексеру(): void\n}\n\nclass \&quot;Әкімші\&quot; as Admin {\n    + бөлім: string\n    --\n    + пайдаланушыҚосу(): void\n    + пайдаланушыБақылау(): void\n    + дәріханаҚосу(): void\n    + дәріҚосу(): void\n    + есепШығару(): void\n}\n\nclass \&quot;Рецепт\&quot; as Prescription {\n    + рецепт_id: int\n    + берілгенКүні: date\n    + жарамдылықМерзімі: date\n    + диагнозы: string\n    + ескертпе: string\n    + статус: string\n    --\n    + жарамдылығынТексеру(): bool\n    + мәртебеніӨзгерту(): void\n}\n\nclass \&quot;Бронь\&quot; as Booking {\n    + бронь_id: int\n    + жасалғанКүні: date\n    + статус: string\n    + QR_код: string\n    --\n    + броньЖасау(): void\n    + броньБолдырмау(): void\n    + QR_кодГенерациялау(): void\n}\n\nclass \&quot;Дәріхана\&quot; as Pharmacy {\n    + дәріхана_id: int\n    + атауы: string\n    + мекенжайы: string\n    + телефон: string\n    + жұмысУақыты: string\n    --\n    + қолжетімдіДәрілерКөру(): list\n    + броньТексеру(): bool\n    + дәрініДайындау(): void\n}\n\nclass \&quot;Дәрі\&quot; as Medicine {\n    + дәрі_id: int\n    + атауы: string\n    + сипаттамасы: string\n    + өндіруші: string\n    + бағасы: float\n    --\n    + мәліметКөру(): void\n    + жаңарту(): void\n}\n\nclass \&quot;РецепттегіДәрі\&quot; as PrescriptionMedicine {\n    + id: int\n    + дозасы: string\n    + қабылдауТәртібі: string\n    + ұзақтығы: int\n    --\n    + мәліметКөру(): void\n    + өзгерту(): void\n}\n\nclass \&quot;ҚабылдауКестесі\&quot; as Schedule {\n    + кесте_id: int\n    + басталуУақыты: datetime\n    + жиілігі: string\n    + мәртебесі: string\n    --\n    + ескеСалуЖіберу(): void\n    + орындалды(): void\n}\n\nclass \&quot;ДәріҚоры\&quot; as Inventory {\n    + id: int\n    + саны: int\n    + жарамдылықКүні: date\n    --\n    + санынЖаңарту(): void\n    + қолжетімдіМе(): bool\n}\n\nUser &lt;|-- Patient\nUser &lt;|-- Doctor\nUser &lt;|-- Pharmacist\nUser &lt;|-- Admin\n\nPatient \&quot;1\&quot; -- \&quot;0..*\&quot; Prescription : алады\nDoctor \&quot;1\&quot; -- \&quot;0..*\&quot; Prescription : жазады\n\nPrescription \&quot;1\&quot; *-- \&quot;0..*\&quot; Booking : негізінде\nBooking \&quot;0..*\&quot; -- \&quot;1\&quot; Pharmacy : жасалады\n\nPrescription \&quot;1\&quot; -- \&quot;1..*\&quot; PrescriptionMedicine : құрамында\n\nMedicine \&quot;1\&quot; -- \&quot;0..*\&quot; PrescriptionMedicine : қолданылады\n\nPrescriptionMedicine \&quot;1\&quot; -- \&quot;0..*\&quot; Schedule : бойынша\n\nMedicine \&quot;1\&quot; -- \&quot;0..*\&quot; Inventory : қорда бар\n\nPharmacy \&quot;1\&quot; -- \&quot;0..*\&quot; Inventory : сақтайды\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IGLZXFIakyhAApsvqjJI-265">
