  <diagram name="Страница-1" id="U5TkKjm03kRQ4fy0V3pK">
    <mxGraphModel dx="1689" dy="921" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Рецепт бойынша дәрілерді брондау жүйесі\ntop to bottom direction\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\nskinparam nodesep 65\nskinparam ranksep 85\nskinparam roundcorner 8\nskinparam defaultFontName Arial\nskinparam classBackgroundColor #F1EFFF\nskinparam classBorderColor #8075C9\nskinparam classArrowColor #777777\nskinparam classFontColor #252545\nhide circle\n\nclass \&quot;Пациент\&quot; as PA {\n  +patient_id : int &lt;&lt;PK&gt;&gt;\n  +full_name : String\n  +birth_date : Date\n  +phone : String\n  +email : String\n  +password : String\n  --\n  +Тіркелу()\n  +Кіру()\n  +РецептКөру()\n  +Брондау()\n}\n\nclass \&quot;Дәрігер\&quot; as D {\n  +doctor_id : int &lt;&lt;PK&gt;&gt;\n  +full_name : String\n  +specialization : String\n  +email : String\n  +password : String\n  --\n  +Кіру()\n  +РецептЖазу()\n  +РецептӨзгерту()\n}\n\nclass \&quot;Фармацевт\&quot; as F {\n  +pharmacist_id : int &lt;&lt;PK&gt;&gt;\n  +pharmacy_id : int &lt;&lt;FK&gt;&gt;\n  +full_name : String\n  +email : String\n  +password : String\n  --\n  +Кіру()\n  +БроньҚабылдау()\n  +QRТексеру()\n  +ДәріДайындау()\n  +ДәріБеру()\n  +ҚордыЖаңарту()\n}\n\nclass \&quot;Әкімші\&quot; as A {\n  +admin_id : int &lt;&lt;PK&gt;&gt;\n  +full_name : String\n  +email : String\n  +password : String\n  --\n  +Кіру()\n  +ЖүйеніБасқару()\n  +ПайдаланушыБасқару()\n}\n\nclass \&quot;Рецепт\&quot; as P {\n  +prescription_id : int &lt;&lt;PK&gt;&gt;\n  +patient_id : int &lt;&lt;FK&gt;&gt;\n  +doctor_id : int &lt;&lt;FK&gt;&gt;\n  +issue_date : Date\n  +status : String\n  --\n  +РецептЖазу()\n  +КүйінӨзгерту()\n}\n\nclass \&quot;Дәрі\&quot; as M {\n  +medicine_id : int &lt;&lt;PK&gt;&gt;\n  +medicine_name : String\n  +manufacturer : String\n  +price : decimal\n  --\n  +ДәрініІздеу()\n  +БағаныӨзгерту()\n}\n\nclass \&quot;Бронь\&quot; as B {\n  +booking_id : int &lt;&lt;PK&gt;&gt;\n  +patient_id : int &lt;&lt;FK&gt;&gt;\n  +prescription_id : int &lt;&lt;FK&gt;&gt;\n  +pharmacy_id : int &lt;&lt;FK&gt;&gt;\n  +pharmacist_id : int &lt;&lt;FK&gt;&gt;\n  +booking_date : DateTime\n  +qr_code : String\n  +status : String\n  --\n  +Брондау()\n  +QRЖасау()\n  +QRТексеру()\n  +КүйінӨзгерту()\n}\n\nclass \&quot;РецепттегіДәрі\&quot; as PM {\n  +prescription_medicine_id : int &lt;&lt;PK&gt;&gt;\n  +prescription_id : int &lt;&lt;FK&gt;&gt;\n  +medicine_id : int &lt;&lt;FK&gt;&gt;\n  +dosage : String\n  +frequency : String\n  +duration_days : int\n  --\n  +ДәріҚосу()\n  +ДозаныӨзгерту()\n}\n\nclass \&quot;Дәріхана\&quot; as PH {\n  +pharmacy_id : int &lt;&lt;PK&gt;&gt;\n  +pharmacy_name : String\n  +address : String\n  +phone : String\n  --\n  +ДәріханаІздеу()\n  +ҚордыКөру()\n}\n\nclass \&quot;ҚабылдауКестесі\&quot; as S {\n  +schedule_id : int &lt;&lt;PK&gt;&gt;\n  +prescription_medicine_id : int &lt;&lt;FK&gt;&gt;\n  +intake_time : DateTime\n  +status : String\n  --\n  +КестеҚұру()\n  +ҚабылдаудыБелгілеу()\n}\n\nclass \&quot;ДәріҚоры\&quot; as I {\n  +inventory_id : int &lt;&lt;PK&gt;&gt;\n  +pharmacy_id : int &lt;&lt;FK&gt;&gt;\n  +medicine_id : int &lt;&lt;FK&gt;&gt;\n  +quantity : int\n  --\n  +ҚордыТексеру()\n  +ҚордыЖаңарту()\n}\n\n&#39; Орналасуды реттеу\nPA -[hidden]right- D\nD -[hidden]right- F\nF -[hidden]right- A\n\nP -[hidden]right- M\nB -[hidden]right- PM\nPH -[hidden]right- S\n\n&#39; Пациент және дәрігер\nPA \&quot;1\&quot; -- \&quot;0..*\&quot; P : алады\nD \&quot;1\&quot; -- \&quot;0..*\&quot; P : жазады\nPA \&quot;1\&quot; -- \&quot;0..*\&quot; B : брондайды\n\n&#39; Рецепт және дәрілер\nP \&quot;1\&quot; -- \&quot;0..*\&quot; PM : қамтиды\nM \&quot;1\&quot; -- \&quot;0..*\&quot; PM : қолданылады\nPM \&quot;1\&quot; -- \&quot;0..*\&quot; S : қабылдау кестесі\n\n&#39; Брондау\nP \&quot;1\&quot; -- \&quot;0..*\&quot; B : негіз болады\nPH \&quot;1\&quot; -- \&quot;0..*\&quot; B : қабылдайды\n\n&#39; Дәріхана қоры\nPH \&quot;1\&quot; -- \&quot;0..*\&quot; I : сақтайды\nM \&quot;1\&quot; -- \&quot;0..*\&quot; I : қорда бар\n\n&#39; Фармацевттің негізгі байланыстары\nPH \&quot;1\&quot; -- \&quot;0..*\&quot; F : жұмыс істейді\nF \&quot;0..1\&quot; -- \&quot;0..*\&quot; B : дәріні дайындайды\nF ..&gt; M : дәріні береді\nF ..&gt; I : қорды жаңартады\n\n&#39; Әкімшінің қызметтік байланыстары\nA ..&gt; PH : басқарады\nA ..&gt; M : деректерді басқарады\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mQeNQrfH39HDJSX_CSJu-1099">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
